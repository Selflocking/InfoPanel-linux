<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:InfoPanel.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfoPanel.Views.Pages.AboutPage">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr S4efca0d10c5f}" FontSize="28" FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Tr S2c0b65a261d7}"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{loc:Tr S24bec7410199}" Click="OpenDataFolder_Click" />
                    <Button Content="{loc:Tr S4862da00cc97}" Click="OpenLogFolder_Click" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckUpdatesButton" Content="{loc:Tr Sf26f3275e735}" Click="CheckUpdates_Click" />
                        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="UpdateBox" IsVisible="False" CornerRadius="6" Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="UpdateTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Tr S9fe6ae8c9fa7}" FontSize="12" FontWeight="SemiBold" />
                            <ScrollViewer MaxHeight="260">
                                <TextBlock x:Name="UpdateNotesText" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <Button x:Name="UpdateDownloadButton" Content="{loc:Tr Sc1c304e33661}" Click="OpenLink_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <WrapPanel>
                    <Button Content="{loc:Tr S86a2a9ba70bc}" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://github.com/emaspa/InfoPanel-linux/blob/main/docs/USER-GUIDE.md" />
                    <Button Content="{loc:Tr Sb5a229ac8bec}" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://infopanel.net/" />
                    <Button Content="{loc:Tr Sf911e414cf6b}" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://github.com/emaspa/InfoPanel-linux" />
                    <Button Content="{loc:Tr S053bc65874ad}" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://discord.gg/cQnjdMC7Qc" />
                    <Button Content="{loc:Tr Seb0050f72303}" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://www.reddit.com/r/InfoPanel/" />
                    <Button Content="{loc:Tr S2af709a32f98}" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://buymeacoffee.com/emaspa" />
                </WrapPanel>
                <Expander Header="{loc:Tr S1254829bd999}" FontSize="12">
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="v0.3.8 alpha: Valkyrie V360 and MC360 LCDs" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="The Valkyrie V360 AIO screen (320x240) now has its own Valkyrie section on the Devices page. It shares its USB ID with the VMAX 4.6&quot; and Jonsbo DS339, so Scan reads the panel's EDID to tell them apart, and a V360 that an earlier release added as a VMAX or DS339 is moved over with its settings. The Valkyrie MC360 (640x480) is supported too, but nobody has tested it on real hardware yet. Contributed by EsiksonX (#13)." />
                        <TextBlock Text="v0.3.7 alpha: Turzx 5&quot; found again after replug, reboot or sleep" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Serial Turing panels were reopened on the /dev/ttyACM path saved at Scan time, but those numbers change after a replug, reboot or panel sleep, so the panel could stay dark until the next Scan. InfoPanel now looks the port up again by USB ID every time the panel starts. A Turzx 5&quot; that is asleep (showing up only as the CT21INCH port, 1a86:ca21) is now woken the way turing-smart-screen-python does it. Reported by Goliohs (#1)." />
                        <TextBlock Text="v0.3.6 alpha: panels sleep and wake with the system" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Before the system suspends, InfoPanel now stops every panel (sending each one its sleep or close command), and restarts them after resume, as the Windows app does. It listens to systemd-logind and holds a sleep delay lock so there is time to do this. Until now a frozen stream could leave a panel dark after a longer suspend: the ASRock Steel Legend 360 goes dark after about a minute without frames and then ignores everything until a full power cycle. Reported by Ulfy." />
                        <TextBlock Text="v0.3.5 alpha: RTX 50 series hotspot no longer floods dmesg" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="On RTX 50 series the hotspot temperature comes from a GPU register the NVIDIA driver only lets root read, and every refused read is logged to the kernel log. InfoPanel probed it at startup, noted it was unavailable, and then kept reading it every second anyway, adding two NVRM lines to dmesg per second. It now probes once and leaves the register alone when the probe fails. Reported by Chris123NT." />
                        <TextBlock Text="v0.3.4 alpha: ASRock Steel Legend 360 LCD support" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{loc:Tr Sbd5c96c4c315}" />
                        <TextBlock Text="v0.3.3 alpha: NVIDIA sensors stop re-initializing every 10 seconds" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Since 0.3.0 the NVIDIA hotspot, VRAM and voltage interface (NvAPI) was torn down and reopened on every 10-second sensor rescan, adding three log lines each time, about 26,000 a day. It now opens once and is only reopened when the GPU actually changes or the driver reports it lost. A card that rejects an individual query, such as a fan it does not have, now just skips that one reading instead of dropping every NVIDIA sensor, and a missing NVIDIA library is retried once a minute rather than every rescan. NVIDIA resources are also released properly when InfoPanel exits." />
                        <TextBlock Text="v0.3.2 alpha: sensor values visible in the Designer picker" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="The Designer's sensor panel showed sensor names but no values. Long names, such as the detailed disk labels introduced with stable sensor ids, made the tree wider than the panel and pushed every value past its right edge. Names now shorten with an ellipsis and show in full as a tooltip, and values always stay in view at any panel width. The Sensors page and the Layers list get the same fix, and the Designer's left panel can no longer be dragged too narrow to show readings." />
                        <TextBlock Text="v0.3.1 alpha: deb and rpm packages, fresh-account data fix" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="InfoPanel now ships as a .deb for Ubuntu 26.04 and an .rpm for Fedora 44 alongside the tarball, and the AUR package is updated automatically with each release. All three install the same layout and are built, linted, installed and run in clean containers before publishing. Fixed a bug on brand-new user accounts: when ~/.local/share did not exist yet, profiles and plugin data were resolved relative to the launch directory, so plugins failed to load and saved profiles could later seem to disappear. Packages now also declare the X11 libraries the interface needs and install a correctly sized icon." />
                        <TextBlock Text="v0.3.0 alpha: sensor bindings survive reboots" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Linux numbers hwmon chips, thermal zones, NVMe controllers and GPUs in kernel probe order, so those numbers move between boots and a saved profile lost its sensors. Sensors are now identified by the hardware itself &#8212; NVMe and disk serials, block WWIDs, GPU UUIDs, USB serials and port paths, PCI and platform addresses, thermal zone types &#8212; instead of by index. Existing profiles are migrated automatically on first load and saved once, using the chip, channel and label recorded with each item as evidence; anything that cannot be matched unambiguously is left alone and flagged rather than silently bound to the wrong device. The sensor tree groups by hardware identity, graph history follows a sensor across a replug, and a new Replace Sensor action repairs a binding whose device genuinely moved. Catalogs rescan every 10 seconds, so hotplugged hardware appears without a restart." />
                        <TextBlock Text="v0.2.4 alpha: fix USB panels dropping to their boot logo" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="A thread-safety bug in the frame-rate counter could crash a panel's render thread mid-session (seen daily on the Trofeo Vision 9.16&quot;), and the device task then hung half-alive: the panel stopped receiving frames, fell back to its boot logo, and only a manual disable/enable brought it back. The counter is now thread-safe, and a crashed render loop takes the whole device task down so the supervisor reconnects the panel automatically within a second. Fixed across all USB panel drivers (Thermalright, Beada, Turing, JL, Jonsbo, Lian Li, Thermaltake)." />
                        <TextBlock Text="v0.2.3 alpha: smooth UI, display assignment, plugin config fix" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Major UI responsiveness work: overlays no longer run the full profile draw on the compositor's render thread (they blit a frame rendered off-thread), plugin images cache their per-frame resizes like video does, and dashboard thumbnails render off the UI thread without a PNG round-trip. Scrolling and animations stay smooth with overlays and panels active. Profiles gain a Display dropdown on the dashboard tiles, and monitor assignment now identifies displays by output name and native resolution (stable under Wayland/XWayland scaling) instead of scaled X11 bounds. Stored plugin config is applied before plugin initialization, so structural settings like the audio spectrum's band count and image size actually take effect instead of silently running on defaults." />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{loc:Tr S3714ab449323}" />
                        <TextBlock Text="v0.2.1 alpha: panel frame rates, video loop fix" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Major frame rate work: profiles with video roughly triple their panel frame rate (frame pacing, per-resolution shared rendering, JPEG encode moved off the render lock, per-frame video resize caching), and looping videos no longer freeze at the loop boundary. Keepalive resends of unchanged content are throttled, fixing a flood that could crash Trofeo bulk panel firmware (recoverable only by replug). udev rules no longer use the plugdev group, which udev 261+ silently rejects, taking panel permissions with it; no group membership is needed anymore. Overlays whose monitor is missing no longer leave a ghost taskbar entry." />
                        <TextBlock Text="v0.2.0 alpha: Lian Li panels, display assignment" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Lian Li panels get their own device family covering the Universal Screen 8.8&quot; and 9.2&quot; and the HydroShift II OLED Curve and LCD; an 8.8&quot; previously configured under the Turing family migrates automatically with its settings. Profiles gain a Display dropdown in the designer to assign the overlay to a monitor (dragging the overlay still works and updates the dropdown). Also fixes Thermalright HID panels (Trofeo 6.86&quot;, Frozen Warframe and similar) wedging on bright, detailed themes by capping JPEG frames at the firmware's buffer size." />
                        <TextBlock Text="v0.1.9 alpha: NVIDIA hotspot, VRAM temperature and more" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Ten new NVIDIA sensors: hotspot temperature, VRAM temperature and core voltage (read through the driver's NvAPI interface, available on the proprietary driver 525 or newer), plus SM and Video clocks, power limit, power as a percentage of the limit, performance state and thermal/power throttling flags. On RTX 50 series cards the hotspot is only readable with root privileges and is omitted otherwise; all other sensors work as a normal user. Sensors your driver or GPU does not support simply do not appear." />
                        <TextBlock Text="v0.1.8 alpha: Thermalright device detection fixes" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Thermalright HID panels that share one USB ID (Frozen Warframe SE, Assassin, BA120 and others on 0416:5302) are now identified as the correct model directly at scan time instead of showing as a Trofeo Vision 6.86&quot; until first connect, and a rescan no longer reverts an identified model to the placeholder. Scanning a family's first panel also enables that family's streaming switch automatically, so a new panel only needs its row toggle and a profile to start streaming." />
                        <TextBlock Text="v0.1.7 alpha: GPU fan RPM sensors" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{loc:Tr Sbc4da74d74eb}" />
                        <TextBlock Text="v0.1.6 alpha: idle plugins power down" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Plugins whose sensors are unused by any streaming panel, overlay or web view for 5 minutes now stop completely, releasing their background resources (audio capture, network fetches, worker threads), and restart within a second when something uses them again. Their sensors stay listed with last-known values, and configured stopwatch hotkeys keep the stopwatch plugin running." />
                        <TextBlock Text="v0.1.5 alpha: demand-driven sensor polling" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Only sensors actually shown on a streaming panel, overlay or web view are polled; plugins whose sensors are unused pause entirely (including their network calls) and resume within a second when needed. The Sensors page, designer and Home screen still show everything live while open. Together with the v0.1.3 rendering work this cuts background CPU and hardware wakeups to a fraction of earlier builds." />
                        <TextBlock Text="v0.1.4 alpha: panel stream cadence fix" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Fixes a v0.1.3 regression: some panel firmwares (Trofeo bulk models in particular) treat a slow stream as stopped and fall back to their boot logo when frames only arrived once a second on static content. Unchanged frames are now resent at the full frame rate from the cached payload, so wire behavior matches pre-0.1.3 builds while the expensive rendering and encoding work stays skipped." />
                        <TextBlock Text="v0.1.3 alpha: performance" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Large CPU and memory reductions: profiles render once per tick and are shared by all panels and the web server, frames whose pixels have not changed skip the resize, encode and USB send entirely (a heartbeat frame keeps panels warm), text layouts are cached instead of re-shaped every frame, and long GIF animations no longer keep every frame in memory. On a bench with three panels streaming, CPU dropped to roughly a quarter of the previous build; mostly static dashboards idle far lower." />
                        <TextBlock Text="v0.1.2 alpha: designer polish" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Three reported paper cuts: the color picker no longer closes the moment a slider is touched (the inspector rebuilt itself on every edit, killing the open flyout and slider drags), the layers panel lists the front-most item at the top so up and down move items the way you expect, and Home screen profile cards show friendly device names for all panel families instead of internal model identifiers." />
                        <TextBlock Text="v0.1.1 alpha: designer stability" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Fixes native crashes while editing a profile with panels streaming: text rendering no longer races on shared fonts across render threads, GPU textures are released on the correct thread (editing or animating images could crash the app), gauge image lists are snapshotted during edits, and a failing display item now skips a frame instead of taking the app down." />
                        <TextBlock Text="v0.1.0 alpha: Jonsbo AIO displays" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="New Jonsbo panel family, both models verified on real hardware: the DS916 (9.16 inch, 462x1920, HLVMAX serial with raw JPEG frames) and the DS339 (376x960, MacroSilicon MS9132 with HID control and bulk UYVY frames). The DS339 shares its USB identity with the VMAX 4.6 inch, so the device scan reads the panel EDID to tell them apart. The VMAX path gains the same Linux protocol fixes (direct hidraw feature reports, UYVY pixel format)." />
                        <TextBlock Text="v0.0.9 alpha: panel options everywhere" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{loc:Tr S6c5f37363e01}" />
                        <TextBlock Text="v0.0.8 alpha: Trofeo HID panel family" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="The Trofeo HID protocol family (6.86 inch and about 15 sibling models) now works: udev rules cover their hidraw nodes, frames stream through the HID interface (the libusb style upgrade cannot work on Linux where the kernel driver owns it), and the device scan no longer aborts when an unreadable HID device is present. Verified on a Trofeo Vision 6.86 inch at 24 fps." />
                        <TextBlock Text="v0.0.7 alpha: stability with multiple panels" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{loc:Tr S4771d74ab3a3}" />
                        <TextBlock Text="v0.0.6 alpha: serial panel speed, 11.3 inch identification" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{loc:Tr Sed99a31cbb5d}" />
                        <TextBlock Text="v0.0.5 alpha: Turing USB panels" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="USB Turing/TURZX panels stream reliably: the protocol now consumes the device response after every command (frames stalled at zero bytes before), and frames are sent as JPEG like the Windows build, roughly tripling the frame rate. Turing devices get a Panel options section with brightness, per-device target FPS and JPEG quality, portrait strips default to 90 degrees at scan, and cards show the native resolution. Shipped stack traces no longer contain build machine paths." />
                        <TextBlock Text="v0.0.4 alpha: serial panel detection" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Serial Turing/Turzx and JL panels are now detected: sysfs symlink resolution in the port scan was broken, so no serial panel was ever found. Scanning no longer resets an identified ChiZhu panel (like the Phantom Spirit 120 Vision EVO) to Unknown. Start minimized works. Launching InfoPanel while it is already running brings the window to the front, and minimizing with close-to-tray enabled no longer crashes." />
                        <TextBlock Text="v0.0.3 alpha: shutdown and serial panel fixes" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{loc:Tr Sd95bfcc15e79}" />
                        <TextBlock Text="v0.0.2 alpha: first published build" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Self-contained tarball on GitHub Releases with installer, udev rules and SMART sensor timer. Update checking with release notes and desktop notification. Plugin-rendered images as live display items (Audio Spectrum bundled), program-specific profiles via foreground app detection, per-profile autosave backup restore, refreshing URL images, Thermaltake/ASRock, JL/Hongtai, VMAX and Lian Li panel support, profile and stopwatch hotkeys, plugin configuration UI, and the full 1.4.x designer feature set (glow, gauge mirror, thousands separator, guide items)." />
                        <TextBlock Text="v0.0.1 alpha: ground-up Linux rebuild" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="New Avalonia 12 UI with a direct-manipulation designer (zoom/pan canvas, undo/redo, layers, live sensor tree). Latest Thermalright/TRCC device support from the Windows fork with USB replug self-healing. Video backgrounds via ffmpeg. Web server, XDG autostart, profile import/export. Profiles remain fully compatible with v1.4 and InfoPanel for Windows." />
                    </StackPanel>
                </Expander>
                <Expander Header="{loc:Tr S350ad433c42f}" FontSize="12">
                    <StackPanel x:Name="ContributorsList" Spacing="4" Margin="0,8,0,0" />
                </Expander>
                <Expander Header="{loc:Tr S0c4ee87a5d79}" FontSize="12">
                    <StackPanel x:Name="LicensesList" Spacing="4" Margin="0,8,0,0" />
                </Expander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
