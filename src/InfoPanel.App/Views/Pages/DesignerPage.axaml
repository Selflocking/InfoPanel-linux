<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:InfoPanel.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:designer="using:InfoPanel.Designer"
             xmlns:models="using:InfoPanel.Models"
             xmlns:vm="using:InfoPanel.ViewModels"
             x:Class="InfoPanel.Views.Pages.DesignerPage">

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ProfilePicker" MinWidth="160" SelectionChanged="ProfilePicker_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Profile">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ToggleSwitch x:Name="ActiveToggle" OnContent="{loc:Tr S92340695899b}" OffContent="{loc:Tr S92340695899b}"
                              IsCheckedChanged="ActiveToggle_Changed" />
                <Separator Width="1" Height="24" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button Content="{loc:Tr S9395f2fb1c65}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{loc:Tr S71988c4d8e08}" Click="AddText_Click" />
                            <MenuItem Header="{loc:Tr S162cc64ca1e4}" Click="AddSensor_Click" />
                            <MenuItem Header="{loc:Tr S93ff9273de4b}" Click="AddClock_Click" />
                            <MenuItem Header="{loc:Tr Sd5d0a30b517e}" Click="AddCalendar_Click" />
                            <MenuItem Header="{loc:Tr S95d64cacce0f}" Click="AddSensorAsBar_Click" />
                            <MenuItem Header="{loc:Tr S32ab018fd38a}" Click="AddSensorAsGraph_Click" />
                            <MenuItem Header="{loc:Tr Scf27745b0afa}" Click="AddSensorAsDonut_Click" />
                            <MenuItem Header="{loc:Tr Sf6d8f4c86ceb}" Click="AddSensorAsGauge_Click" />
                            <MenuItem Header="{loc:Tr S1a8bcf8a00eb}" Click="AddSensorAsImage_Click" />
                            <Separator />
                            <MenuItem Header="{loc:Tr S9832c2be9608}" Click="AddImage_Click" />
                            <MenuItem Header="{loc:Tr Se0e492707f85}" Click="AddShape_Click" />
                            <MenuItem Header="{loc:Tr S34ca0e766088}" Click="AddGroup_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="UndoButton" Content="{loc:Tr S6372c71f9997}" ToolTip.Tip="{loc:Tr Sa67232246217}" Click="Undo_Click" IsEnabled="False" />
                <Button x:Name="RedoButton" Content="{loc:Tr S3deaed8566f2}" ToolTip.Tip="{loc:Tr S3231090430a1}" Click="Redo_Click" IsEnabled="False" />
                <Separator Width="1" Height="24" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton x:Name="SnapToggle" Content="{loc:Tr S98df9a59f064}" IsChecked="True" Click="Snap_Click" />
                <Button Content="{loc:Tr S9f872ed43d00}" Click="Fit_Click" />
                <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Text="100%"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" MinWidth="44" />
                <Separator Width="1" Height="24" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button Content="{loc:Tr S1509f561f241}" Click="Save_Click" />
                <Button Content="{loc:Tr Sbdc090ec61e3}" Click="Reload_Click" ToolTip.Tip="{loc:Tr Se4e0fab147f7}" />
                <Button Content="{loc:Tr Sa76e13b98392}" Click="Restore_Click" ToolTip.Tip="{loc:Tr Sf270bc582b7d}" />
                <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Leave room for indentation and readings when the splitter is narrowed. -->
                <ColumnDefinition Width="270" MinWidth="210" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: layers + sensors -->
            <TabControl Grid.Column="0">
                <TabItem Header="{loc:Tr S0bcd66e677f4}">
                    <DockPanel>
                        <TextBox x:Name="LayerSearch" DockPanel.Dock="Top" PlaceholderText="{loc:Tr S40901fc75e52}"
                                 Margin="4" TextChanged="LayerSearch_TextChanged" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="4" Spacing="0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Tr S730ead39c4cd}" FontSize="11" Margin="0,0,4,4" Click="LayerDelete_Click" ToolTip.Tip="{loc:Tr Sd2ab5d46fed4}" />
                                <Button Content="{loc:Tr Saceb94c763eb}" FontSize="11" Margin="0,0,4,4" Click="LayerDuplicate_Click" ToolTip.Tip="{loc:Tr Sae77efb2efa7}" />
                                <Button Content="↑" FontSize="11" Margin="0,0,4,4" Click="LayerUp_Click" ToolTip.Tip="{loc:Tr S1d10933d1daa}" />
                                <Button Content="↓" FontSize="11" Margin="0,0,4,4" Click="LayerDown_Click" ToolTip.Tip="{loc:Tr S7949823c8936}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Tr Sd5cdfcf7ff75}" FontSize="11" Margin="0,0,4,4" Click="LayerTop_Click" ToolTip.Tip="{loc:Tr S520cdb7e4609}" />
                                <Button Content="{loc:Tr S479ad21ac909}" FontSize="11" Margin="0,0,4,4" Click="LayerBottom_Click" ToolTip.Tip="{loc:Tr Se3daa79eaf69}" />
                            </StackPanel>
                        </StackPanel>
                        <TreeView x:Name="LayersTree" SelectionChanged="LayersTree_SelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:DisplayItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                        <TextBlock Text="{Binding Kind}" FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Grid.Column="2" FontSize="10" Opacity="0.55" VerticalAlignment="Center">
                                            <Run Text="(" /><Run Text="{Binding X}" /><Run Text="," /><Run Text="{Binding Y}" /><Run Text=")" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{loc:Tr S44bd7ae60f47}" FontSize="10" Opacity="0.6" IsVisible="{Binding Hidden}" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Tr S72dfcfb0c470}" FontSize="10" Opacity="0.6" IsVisible="{Binding IsLocked}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{loc:Tr S76140e34f635}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4">
                            <Button DockPanel.Dock="Right" Content="⟳" ToolTip.Tip="{loc:Tr Sc6432b48be92}" Click="RefreshSensors_Click" Margin="4,0,0,0" />
                            <TextBox x:Name="SensorSearch" PlaceholderText="{loc:Tr Sba86fb09cb91}" TextChanged="SensorSearch_TextChanged" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="4" Spacing="4">
                            <TextBlock Text="{loc:Tr S5e21210d5a9a}" FontSize="11" Opacity="0.7" />
                            <WrapPanel>
                                <Button Content="{loc:Tr S71988c4d8e08}" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsText_Click" />
                                <Button Content="{loc:Tr S95d64cacce0f}" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsBar_Click" />
                                <Button Content="{loc:Tr S32ab018fd38a}" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsGraph_Click" />
                                <Button Content="{loc:Tr Scf27745b0afa}" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsDonut_Click" />
                                <Button Content="{loc:Tr Sf6d8f4c86ceb}" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsGauge_Click" />
                                <Button Content="{loc:Tr S1aa4cb0bcca7}" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsImage_Click" />
                            </WrapPanel>
                            <Button Content="{loc:Tr S18c1396b5814}" FontSize="11" Click="ReplaceSensor_Click"
                                    ToolTip.Tip="{loc:Tr S7d1092e048f5}" />
                        </StackPanel>
                        <TreeView x:Name="SensorTree" DoubleTapped="SensorTree_DoubleTapped"
                                  Tapped="SensorTree_Tapped"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="SensorTree_SelectionChanged">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="vm:SensorTreeItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:SensorTreeItem" ItemsSource="{Binding Children}">
                                    <Grid ColumnDefinitions="*,Auto" Opacity="{Binding DisplayOpacity}">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                                   FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                <designer:DesignCanvas x:Name="Canvas" />
                <ScrollBar x:Name="CanvasVScroll" Grid.Column="1" Orientation="Vertical"
                           AllowAutoHide="False" IsVisible="False" />
                <ScrollBar x:Name="CanvasHScroll" Grid.Row="1" Orientation="Horizontal"
                           AllowAutoHide="False" IsVisible="False" />
            </Grid>

            <GridSplitter Grid.Column="3" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Right: inspector -->
            <designer:InspectorPanel x:Name="Inspector" Grid.Column="4" />

        </Grid>

    </DockPanel>

</UserControl>
