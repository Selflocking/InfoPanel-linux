<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:InfoPanel.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfoPanel.Views.Pages.DevicesPage">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ScanButton" Content="{loc:Tr S8a778ed913d0}" Click="Scan_Click" />
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr S4ba5121d4d1b}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Tr S957299b89ef4}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="ScanStatus" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="False" />

            <StackPanel x:Name="DeviceRows" Spacing="12" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
